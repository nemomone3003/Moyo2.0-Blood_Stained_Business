<?xml version="1.0" encoding="UTF-8"?>
<Patch>

    <!-- Not done -->

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Moyo2_CCCHelmet"]/statBases</xpath>
        <value>
            <Bulk>6</Bulk>
            <WornBulk>3</WornBulk>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Moyo2_CCCHelmet"]/statBases/Mass</xpath>
        <value>
            <Mass>5</Mass>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Moyo2_CCCHelmet"]/statBases/ArmorRating_Sharp</xpath>
        <value>
            <ArmorRating_Sharp>18</ArmorRating_Sharp>
            <ArmorRating_Electric>0.3</ArmorRating_Electric>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Moyo2_CCCHelmet"]/statBases/ArmorRating_Blunt</xpath>
        <value>
            <ArmorRating_Blunt>41.5</ArmorRating_Blunt>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Moyo2_CCCHelmet"]/statBases/Flammability</xpath>
        <value>
            <Flammability>0</Flammability>
        </value>
    </Operation>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="Moyo2_CCCHelmet"]/apparel/immuneToToxGasExposure</xpath>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="Moyo2_CCCHelmet"]/apparel</xpath>
            <value>
                <immuneToToxGasExposure>true</immuneToToxGasExposure>
            </value>
        </nomatch>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Moyo2_CCCHelmet"]/equippedStatOffsets</xpath>
        <value>
            <SmokeSensitivity>-1</SmokeSensitivity>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Moyo2_CCCHelmet"]/apparel/layers</xpath>
        <value>
            <layers>
                <li>OnHead</li>
                <li>StrappedHead</li>
                <li>Overhead</li>
            </layers>
        </value>
    </Operation>

</Patch>